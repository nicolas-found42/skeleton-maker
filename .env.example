# Copy to .env and fill in, or export these in your shell.

# Required. Get one at https://build.nvidia.com/nvidia/body-pose ("Get API Key").
NVIDIA_API_KEY=nvapi-...

# Optional. Defaults to the hosted 3D Body Pose function.
SKELETON_MAKER_FUNCTION_ID=254b3621-bb66-4b7b-9c89-621c352b4d91
SKELETON_MAKER_TARGET=grpc.nvcf.nvidia.com:443
